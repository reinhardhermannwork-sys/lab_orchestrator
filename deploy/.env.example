# Settings for `docker compose --env-file deploy/.env up -d`.
# Copy to deploy/.env (git-ignored) and edit. This file is used twice:
# compose reads it for the variables in compose.yaml, and the container
# gets it as its environment (LAB_ORCH_* settings, see README).

# --- compose-level ---------------------------------------------------------

# Existing user-defined bridge network shared with the web frontend and
# Guacamole (architecture doc §17). Create once if it doesn't exist:
#   docker network create lab
LAB_NETWORK=lab

# Host path of the machine definitions (mounted read-only).
LAB_ORCH_HOST_MACHINES_CONFIG=./config/machines.yaml

# Host directory with the orchestrator's secrets (mounted read-only):
#   tux2lab_ssh_key   private key for the lab-orchestrator account (M10)
#   known_hosts       the host's SSH host key under the name the container
#                     connects to; on the host:
#                       ssh-keyscan -t ed25519 127.0.0.1 \
#                         | sed 's/^127.0.0.1/host.docker.internal/' > known_hosts
# The container runs as uid 10001, so make the files readable to it:
#   sudo chown 10001 tux2lab_ssh_key known_hosts && sudo chmod 400 tux2lab_ssh_key
# Stage 1 (fake backend) doesn't need either file.
LAB_ORCH_HOST_SECRETS_DIR=./deploy/secrets

# LAB_ORCH_IMAGE_TAG=latest

# --- web frontend (M9) ------------------------------------------------------

# Traefik routing for the frontend — only read with deploy/compose.traefik.yaml
# (not with deploy/compose.test.yaml). Use the names from your traefik setup:
#   LAB_FRONTEND_ROUTER_RULE  which requests go to the frontend
#   TRAEFIK_ENTRYPOINT        the HTTPS entrypoint's name
#   TRAEFIK_CERTRESOLVER      the certificate resolver's name
#   TRAEFIK_AUTH_MIDDLEWARE   the authentik forward-auth middleware, e.g.
#                             "authentik@docker" or "authentik@file". It must
#                             list X-authentik-username in authResponseHeaders.
LAB_FRONTEND_ROUTER_RULE=Host(`planetsexpress.dedyn.io`)
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
TRAEFIK_AUTH_MIDDLEWARE=authentik@docker
# LAB_FRONTEND_USER_HEADER=X-authentik-username

# Test machines only (read by deploy/compose.test.yaml, never by
# compose.traefik.yaml): user for browser requests without the identity
# header, e.g. through an SSH tunnel.
# LAB_FRONTEND_DEV_USER=hermann

# --- orchestrator settings (LAB_ORCH_*) -------------------------------------

# fake: stage 1 (M8), no real VMs.  ssh: stage 2 (M10), real tux2lab via the
# host wrapper; startup fails if the SSH settings are missing.
LAB_ORCH_TUX2LAB_BACKEND=fake

LAB_ORCH_LOG_LEVEL=INFO

# Host wrapper connection (used when LAB_ORCH_TUX2LAB_BACKEND=ssh). Key and
# known_hosts paths are fixed by compose.yaml.
LAB_ORCH_TUX2LAB_SSH_HOST=host.docker.internal
LAB_ORCH_TUX2LAB_SSH_PORT=22
LAB_ORCH_TUX2LAB_SSH_USERNAME=lab-orchestrator

# Optional overrides; defaults are in src/lab_orchestrator/core/config.py.
# LAB_ORCH_LEASE_LIFETIME_HOURS=4.0
# LAB_ORCH_PROVISIONING_TIMEOUT_SECONDS=300.0
# LAB_ORCH_JANITOR_POLL_INTERVAL_SECONDS=15.0
# LAB_ORCH_DISCONNECT_GRACE_SECONDS=300.0
# LAB_ORCH_VM_SSH_USERNAME=labuser
