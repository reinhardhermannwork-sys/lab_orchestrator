# Settings of the simulation instance (deploy/compose.sim.yaml). Copy to
# deploy/sim.env (git-ignored) and edit. Paths of the key, known_hosts, DB
# and machines file are fixed in compose.sim.yaml.

LAB_ORCH_LOG_LEVEL=INFO

# The host's sshd, where the restricted wrapper runs mercury-sim.
LAB_ORCH_MERCURY_SIM_SSH_HOST=host.docker.internal
LAB_ORCH_MERCURY_SIM_SSH_PORT=22
LAB_ORCH_MERCURY_SIM_SSH_USERNAME=lab-orchestrator

# How many simulations at once. SP6 (2026-11-01) ran two in parallel on the
# test VM (4 CPUs, 6 GB): WASHDOWN 68 s each, as alone; load 4.3, 1.47 GB left.
# A third would leave too little RAM, so 2 here.
LAB_ORCH_MAX_ACTIVE_MERCURY_SIM=2

# Only mercsc0000 is in machines.sim.yaml, so tux2lab gets no client; "fake"
# keeps a stray setting from ever reaching for tux2lab here.
LAB_ORCH_TUX2LAB_BACKEND=fake
