#!/usr/bin/env bash
# SSH forced command for the host account `lab-orchestrator` (architecture
# doc §11, implementation plan M10). sshd runs this instead of whatever the
# orchestrator asked for and puts the request in SSH_ORIGINAL_COMMAND.
#
# Allowed, and nothing else:
#   tux2lab vm list
#   tux2lab vm info    -H <hostname>
#   tux2lab vm start   -H <hostname>
#   tux2lab vm remove  -H <hostname>              → runs with -f added
#   tux2lab vm install -H <hostname> -i <image>   → -i mapped to -d/-v and
#                                                   the image's --cpu/--memory
#   mercury-sim list                               (M13, architecture doc §18)
#   mercury-sim info|start|remove|runs -H <hostname>
#   mercury-sim install -H <hostname> -i <image> [--setup-b64 <base64url>]
#   mercury-sim run -H <hostname> -r <recipe> --id <run id>
#
# <hostname> and <image> must match the orchestrator adapter's own patterns
# (_HOSTNAME_RE, _IMAGE_NAME_RE in adapters/tux2lab_client.py). The real CLI
# runs as the tux2lab user through one sudoers rule, with stdin from
# /dev/null so an interactive prompt can't wait for input. Its stdout,
# stderr and exit code pass through unchanged: tux2lab prints errors to
# stdout, and the orchestrator reads them there (decided, §11).
#
# Before an install, the wrapper checks that the host has the VM's memory
# plus RESERVE_MIB available (MemAvailable). If not, it prints an [ERROR]
# line on stdout and exits 75 (EX_TEMPFAIL) without calling tux2lab, so a
# full host refuses new VMs instead of running out of RAM.
#
# mercury-sim (the simulation host CLI, mercury-lab docs/sim-host.md) runs
# the same way as MERCURY_SIM_USER. Before its install the wrapper checks
# MemAvailable >= SIM_MEMORY_MIB + RESERVE_MIB and, since a simulated
# Mercury is CPU-bound, 1-minute load + SIM_CPU <= CPUs; otherwise
# {"error": ...} on stdout and exit 75. The CLI prints JSON itself.
#
# Configuration: /etc/lab-orchestrator/wrapper.conf (shell variables)
#   TUX2LAB_USER   account that runs tux2lab (the lab user)       required for tux2lab
#   TUX2LAB_BIN    path of the tux2lab CLI                        default /usr/local/bin/tux2lab
#   IMAGES_CONF    image map, "<image> <distro> <version> [<cpu> <memory_gib>]" lines
#                                                                 default /etc/lab-orchestrator/images.conf
#   RESERVE_MIB    RAM kept free for the host, on top of the VM   default 1024
#   MEMINFO        where MemAvailable is read (tests)             default /proc/meminfo
#   MERCURY_SIM_USER  account that runs mercury-sim               required for mercury-sim
#   MERCURY_SIM_BIN   path of the mercury-sim CLI                 default /usr/local/bin/mercury-sim
#   SIM_MEMORY_MIB    RAM one simulation needs                    default 1536
#   SIM_CPU           CPUs one simulation keeps busy              default 2
#   LOADAVG           where the load is read (tests)              default /proc/loadavg
#   NPROC             CPUs of the host (tests)                    default: nproc
set -uo pipefail

CONF="${LAB_ORCHESTRATOR_WRAPPER_CONF:-/etc/lab-orchestrator/wrapper.conf}"
TUX2LAB_USER=""
TUX2LAB_BIN="/usr/local/bin/tux2lab"
IMAGES_CONF="/etc/lab-orchestrator/images.conf"
RESERVE_MIB=1024
MEMINFO="/proc/meminfo"
MERCURY_SIM_USER=""
MERCURY_SIM_BIN="/usr/local/bin/mercury-sim"
SIM_MEMORY_MIB=1536
SIM_CPU=2
LOADAVG="/proc/loadavg"
NPROC=""
# shellcheck source=/dev/null
[[ -r "$CONF" ]] && source "$CONF"

HOSTNAME_RE='^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$'
IMAGE_RE='^[A-Za-z0-9_.-]{1,128}$'
RECIPE_RE='^[A-Za-z0-9_.-]{1,64}$'
RUN_ID_RE='^[0-9A-HJKMNP-TV-Z]{26}$'
# No {1,22000} bound here: glibc's regex engine expands large repeat
# counts into gigabytes of RAM. The length is checked on its own instead.
SETUP_B64_RE='^[A-Za-z0-9_-]+$'
SETUP_B64_MAX=22000
TAG="lab-orchestrator-wrapper"

log() { logger -t "$TAG" -- "$*" 2>/dev/null || true; }

refuse() {
    log "REFUSED: ${1} (request: ${request@Q})"
    echo "lab-orchestrator-wrapper: refused: ${1}" >&2
    exit 126
}

request="${SSH_ORIGINAL_COMMAND:-}"

# Only plain words separated by single spaces. This rules out quoting,
# globbing, variables, redirection and command separators before any
# splitting happens.
[[ "$request" =~ ^[A-Za-z0-9_.\ -]+$ ]] || refuse "unexpected characters"
read -r -a words <<< "$request"
[[ "${words[*]}" == "$request" ]] || refuse "unexpected spacing"

check_host() { [[ "$1" =~ $HOSTNAME_RE ]] || refuse "invalid hostname"; }

# Map an image name to "-d <distro> -v <version>" (interim, §3/§14.8),
# plus "--cpu <n> --memory <gib>" when the entry sets a size. The size
# lives here, on the host, so the orchestrator can't ask for more.
# Without one, tux2lab's default applies (2 vCPU / 2 GiB).
map_image() {
    local image="$1" name distro version cpu memory extra
    [[ "$image" =~ $IMAGE_RE ]] || refuse "invalid image name"
    [[ -r "$IMAGES_CONF" ]] || refuse "image map $IMAGES_CONF not readable"
    while read -r name distro version cpu memory extra; do
        [[ -z "$name" || "$name" == \#* ]] && continue
        if [[ "$name" == "$image" ]]; then
            [[ "$distro" =~ ^[a-z0-9-]+$ && "$version" =~ ^[0-9.]+$ && -z "$extra" ]] \
                || refuse "bad image map entry for $image"
            mapped=(-d "$distro" -v "$version")
            vm_memory_gib=2
            if [[ -n "$cpu" || -n "$memory" ]]; then
                [[ "$cpu" =~ ^(1|2|4|8)$ && "$memory" =~ ^(1|2|4|8|16)$ ]] \
                    || refuse "bad image map entry for $image"
                mapped+=(--cpu "$cpu" --memory "$memory")
                vm_memory_gib=$memory
            fi
            return
        fi
    done < "$IMAGES_CONF"
    refuse "image not in map: $image"
}

# Exit 75 unless the host has the VM's memory plus RESERVE_MIB available.
check_memory() {
    local avail_kib need_mib
    [[ "$RESERVE_MIB" =~ ^[0-9]+$ ]] || refuse "RESERVE_MIB must be a number"
    avail_kib=$(awk '/^MemAvailable:/ {print $2; exit}' "$MEMINFO" 2>/dev/null)
    [[ "$avail_kib" =~ ^[0-9]+$ ]] || refuse "cannot read MemAvailable from $MEMINFO"
    need_mib=$(( vm_memory_gib * 1024 + RESERVE_MIB ))
    if (( avail_kib / 1024 < need_mib )); then
        log "OUT OF MEMORY: ${avail_kib}KiB available, ${need_mib}MiB needed (request: ${request@Q})"
        echo "[ERROR] lab host is out of memory: $(( avail_kib / 1024 )) MiB available, ${need_mib} MiB needed."
        exit 75
    fi
}

# mercury-sim: exit 75 unless the host has RAM and CPU for one more simulation.
check_sim_capacity() {
    local avail_kib need_mib load cpus
    [[ "$RESERVE_MIB" =~ ^[0-9]+$ && "$SIM_MEMORY_MIB" =~ ^[0-9]+$ && "$SIM_CPU" =~ ^[0-9]+$ ]] \
        || refuse "RESERVE_MIB, SIM_MEMORY_MIB and SIM_CPU must be numbers"
    avail_kib=$(awk '/^MemAvailable:/ {print $2; exit}' "$MEMINFO" 2>/dev/null)
    [[ "$avail_kib" =~ ^[0-9]+$ ]] || refuse "cannot read MemAvailable from $MEMINFO"
    need_mib=$(( SIM_MEMORY_MIB + RESERVE_MIB ))
    if (( avail_kib / 1024 < need_mib )); then
        log "OUT OF MEMORY: ${avail_kib}KiB available, ${need_mib}MiB needed (request: ${request@Q})"
        echo "{\"error\": \"lab host is out of memory: $(( avail_kib / 1024 )) MiB available, ${need_mib} MiB needed\"}"
        exit 75
    fi
    load=$(awk '{print $1; exit}' "$LOADAVG" 2>/dev/null)
    [[ "$load" =~ ^[0-9]+(\.[0-9]+)?$ ]] || refuse "cannot read the load from $LOADAVG"
    cpus=${NPROC:-$(nproc)}
    [[ "$cpus" =~ ^[0-9]+$ ]] || refuse "NPROC must be a number"
    if awk -v l="$load" -v c="$SIM_CPU" -v n="$cpus" 'BEGIN { exit !(l + c > n) }'; then
        log "OUT OF CPU: load $load + $SIM_CPU > $cpus CPUs (request: ${request@Q})"
        echo "{\"error\": \"lab host is out of CPU: load $load, a simulation needs $SIM_CPU of $cpus CPUs\"}"
        exit 75
    fi
}

declare -a cli
n=${#words[@]}
if [[ $n -ge 2 && "${words[0]}" == "mercury-sim" ]]; then
    [[ -n "$MERCURY_SIM_USER" ]] || refuse "MERCURY_SIM_USER not set in $CONF"
    verb="${words[1]}"
    case "$verb" in
        list)
            [[ $n -eq 2 ]] || refuse "list takes no arguments"
            ;;
        info|start|remove|runs)
            [[ $n -eq 4 && "${words[2]}" == "-H" ]] || refuse "expected: mercury-sim $verb -H <hostname>"
            check_host "${words[3]}"
            ;;
        install)
            [[ ($n -eq 6 || ($n -eq 8 && "${words[6]}" == "--setup-b64")) \
                && "${words[2]}" == "-H" && "${words[4]}" == "-i" ]] \
                || refuse "expected: mercury-sim install -H <hostname> -i <image> [--setup-b64 <base64url>]"
            check_host "${words[3]}"
            [[ "${words[5]}" =~ $IMAGE_RE ]] || refuse "invalid image name"
            [[ $n -eq 6 || ( ${#words[7]} -le $SETUP_B64_MAX && "${words[7]}" =~ $SETUP_B64_RE ) ]] \
                || refuse "invalid setup"
            check_sim_capacity
            ;;
        run)
            [[ $n -eq 8 && "${words[2]}" == "-H" && "${words[4]}" == "-r" && "${words[6]}" == "--id" ]] \
                || refuse "expected: mercury-sim run -H <hostname> -r <recipe> --id <run id>"
            check_host "${words[3]}"
            [[ "${words[5]}" =~ $RECIPE_RE ]] || refuse "invalid recipe"
            [[ "${words[7]}" =~ $RUN_ID_RE ]] || refuse "invalid run id"
            ;;
        *)
            refuse "command not allowed: mercury-sim $verb"
            ;;
    esac
    cli=("${words[@]:1}")
    log "RUN: mercury-sim ${cli[*]}"
    sudo -n -H -u "$MERCURY_SIM_USER" -- "$MERCURY_SIM_BIN" "${cli[@]}" </dev/null
    status=$?
    log "EXIT $status: mercury-sim ${cli[*]}"
    exit "$status"
fi

[[ -n "$TUX2LAB_USER" ]] || refuse "TUX2LAB_USER not set in $CONF"
if [[ $n -ge 3 && "${words[0]}" == "tux2lab" && "${words[1]}" == "vm" ]]; then
    case "${words[2]}" in
        list)
            [[ $n -eq 3 ]] || refuse "vm list takes no arguments"
            cli=(vm list)
            ;;
        info|start)
            [[ $n -eq 5 && "${words[3]}" == "-H" ]] || refuse "expected: vm ${words[2]} -H <hostname>"
            check_host "${words[4]}"
            cli=(vm "${words[2]}" -H "${words[4]}")
            ;;
        remove)
            [[ $n -eq 5 && "${words[3]}" == "-H" ]] || refuse "expected: vm remove -H <hostname>"
            check_host "${words[4]}"
            cli=(vm remove -H "${words[4]}" -f)
            ;;
        install)
            [[ $n -eq 7 && "${words[3]}" == "-H" && "${words[5]}" == "-i" ]] \
                || refuse "expected: vm install -H <hostname> -i <image>"
            check_host "${words[4]}"
            declare -a mapped
            vm_memory_gib=2
            map_image "${words[6]}"
            check_memory
            cli=(vm install -H "${words[4]}" "${mapped[@]}")
            ;;
        *)
            refuse "command not allowed: vm ${words[2]}"
            ;;
    esac
else
    refuse "command not allowed"
fi

log "RUN: tux2lab ${cli[*]}"
sudo -n -H -u "$TUX2LAB_USER" -- "$TUX2LAB_BIN" "${cli[@]}" </dev/null
status=$?
log "EXIT $status: tux2lab ${cli[*]}"
exit "$status"
