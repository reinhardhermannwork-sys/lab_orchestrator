# /etc/lab-orchestrator/wrapper.conf — read by the wrapper (shell syntax).

# The lab user that runs tux2lab (the account tux2lab was set up with; it
# must not be root).
TUX2LAB_USER=hermann

# Path of the tux2lab CLI (`command -v tux2lab` as that user).
TUX2LAB_BIN=/usr/local/bin/tux2lab

# Image map, see images.conf.example.
IMAGES_CONF=/etc/lab-orchestrator/images.conf

# RAM (MiB) that must stay free for the host and its other services, on
# top of the VM's own memory. An install is refused (exit 75, "lab host is
# out of memory") when MemAvailable is below VM memory + RESERVE_MIB.
RESERVE_MIB=1024

# --- mercury-sim (M13, architecture doc §18) --------------------------------
# Leave MERCURY_SIM_USER empty on hosts without the simulation host CLI: the
# wrapper then refuses every mercury-sim request.

# The account that runs mercury-sim (owner of the mercury-lab checkout; it
# needs `sudo docker`, the CLI's default MERCURY_SIM_DOCKER).
MERCURY_SIM_USER=

# Root-owned launcher of the CLI, see README.md "mercury-sim".
MERCURY_SIM_BIN=/usr/local/bin/mercury-sim

# What one simulation needs. An install is refused (exit 75) when
# MemAvailable < SIM_MEMORY_MIB + RESERVE_MIB, or when the 1-minute load +
# SIM_CPU is more than the host's CPUs (a simulated Mercury is CPU-bound).
# Measured in SP6 (2026-11-01, test VM, 4 CPUs / 6 GB): one sim (Mercury +
# its msim) takes about 0.9 GB and 0.75-1 CPU, idle or running a recipe.
SIM_MEMORY_MIB=1024
SIM_CPU=1
