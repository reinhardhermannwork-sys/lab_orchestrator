# /etc/lab-orchestrator/wrapper.conf — read by the wrapper (shell syntax).

# The lab user that runs tux2lab (the account tux2lab was set up with; it
# must not be root).
TUX2LAB_USER=hermann

# Path of the tux2lab CLI (`command -v tux2lab` as that user).
TUX2LAB_BIN=/usr/local/bin/tux2lab

# Image map, see images.conf.example.
IMAGES_CONF=/etc/lab-orchestrator/images.conf

# RAM (MiB) that must stay free for the host and its other services, on
# top of the VM's own memory. An install is refused (exit 75, "lab host is
# out of memory") when MemAvailable is below VM memory + RESERVE_MIB.
RESERVE_MIB=1024
