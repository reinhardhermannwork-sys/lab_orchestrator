{
  "name": "lab-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Web frontend for the lab orchestrator (M9): React + Tailwind client, thin Fastify server.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:client": "vite",
    "dev:server": "node --watch server/index.ts",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node server/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "fastify": "^5.12.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
